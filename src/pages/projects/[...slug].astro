---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, type, links } = project.data;

import Video from "../../components/visual/Video.astro";
import Iframe from "../../components/visual/Iframe.astro";
import Images from "../../components/visual/Images.astro";
import ProjectLinks from "../../components/ProjectLinks.astro";
import AiBadge from "../../components/AiBadge.astro";
---

<Layout title={title}>
    <article class="project-view">
        <div class:list={["hero-visual", { "is-video": type === "video" }]}>
            {
                type === "video" && (
                    <Video
                        src={project.data.video}
                        poster={project.data.poster}
                    />
                )
            }
            {type === "images" && <Images images={project.data.images} />}
            {type === "iframe" && <Iframe src={project.data.iframe} />}
        </div>
        <header>
            <h1>{title}</h1>
            <div class="meta">
                <p class="date">{project.data.date.toISOString().split("T")[0]}</p>
                <AiBadge level={project.data.ai} showLabel />
            </div>
        </header>

        <section class="content">
            <Content />
        </section>
        <footer>
            <ProjectLinks links={links} />
        </footer>
    </article>
</Layout>

<style>
    .project-view {
        max-width: 800px;
        margin: 0 auto;
    }
    .meta {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: var(--pico-spacing);
        color: var(--pico-muted-color);
    }
    .meta .date {
        margin: 0;
    }
    .content {
        line-height: 1.6;
    }
    .hero-visual {
        width: 100%;
        aspect-ratio: 16 / 9;
        margin-bottom: var(--pico-spacing);
        background-color: var(--pico-card-background-color);
        border-radius: var(--pico-border-radius);
        overflow: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    /* videos are (near) square: show them whole instead of cropping to 16:9 */
    .hero-visual.is-video {
        aspect-ratio: 1;
        max-height: 75vh;
    }
    .hero-visual.is-video :global(video) {
        object-fit: contain;
    }
    .content :global(img) {
        border-radius: var(--pico-border-radius);
        margin-bottom: var(--pico-spacing);
    }
</style>
