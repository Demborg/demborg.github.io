---
import type { CollectionEntry } from "astro:content";
import Iframe from "./visual/Iframe.astro";
import Images from "./visual/Images.astro";
import Video from "./visual/Video.astro";
import ProjectLinks from "./ProjectLinks.astro";
import AiBadge from "./AiBadge.astro";

interface Props {
    project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, links } = project.data;
---

<article class="group">
    <div class="visuals">
        {
            project.data.type === "video" && (
                <Video src={project.data.video} poster={project.data.poster} />
            )
        }
        {
            project.data.type === "images" && (
                <Images images={project.data.images} />
            )
        }
        {project.data.type === "iframe" && <Iframe src={project.data.iframe} />}
    </div>

    <div class="overlay">
        <header>
            <a href={`/projects/${project.id}`}>
                <h3>{title}</h3>
            </a>
            <AiBadge level={project.data.ai} />
        </header>
        <ProjectLinks links={links} />
    </div>
</article>

<style>
    article {
        padding: 0;
        overflow: hidden;
    }
    article .overlay {
        padding: var(--pico-spacing);
    }
    article header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: var(--pico-typography-spacing-vertical);
    }
    article header h3 {
        margin-bottom: 0;
    }
    article header :global(.ai-badge) {
        margin-top: 0.15rem;
    }
    article header :global(.ai-badge) {
        font-size: 0.85rem;
    }
    article .visuals {
        width: 100%;
        aspect-ratio: 1;
        overflow: hidden;
    }
</style>
