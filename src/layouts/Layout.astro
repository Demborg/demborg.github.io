---
interface Props {
    title: string;
}
const { title } = Astro.props;
import Nav from "../components/Nav.astro";

import "../styles/global.css"
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>{title}</title>
        <link rel="icon" type="image/png" href="/favicon.png" />
    </head>
    <body>
        <Nav />
        <main class="container">
            <slot />
        </main>
    </body>
</html>
